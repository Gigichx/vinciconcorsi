{
  "name": "vinciconcorsi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev . --port 8788 --ip 127.0.0.1",
    "db:local": "wrangler d1 execute vinciconcorsi-reviews --local --file=./schema.sql",
